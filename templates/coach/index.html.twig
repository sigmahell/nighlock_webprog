{% extends 'base.html.twig' %}

{% block title %}Coaching Sessions - NightLock{% endblock %}

{% block body %}
<div class="coaches-container">

    {# ================================================
       SECTION 1: ALL COACHES GRID
    ================================================ #}
    <section id="all-coaches">
        <h2 class="section-title">COACHES</h2>
        {% if coaches is empty %}
            <p style="color: var(--text-muted); text-align: center; padding: 2rem 0;">
                No coaches available at this time.
            </p>
        {% else %}
            <div class="pro-grid">
                {% for coach in coaches %}
                    <div class="pro-card">
                        <div class="pro-card-header">
                            <img src="{{ asset('images/background.png') }}" class="pro-banner-img" alt="Card Banner">
                        </div>
                        <div class="pro-card-body">
                            <div class="pro-user-row">
                                <img src="{{ coach.image ? asset('images/' ~ coach.image) : asset('images/default-avatar.png') }}"
                                     class="pro-avatar" alt="{{ coach.name }}"
                                     onerror="this.onerror=null; this.src='{{ asset('images/default-avatar.png') }}';">
                                <div>
                                    <h3 class="pro-card-title">{{ coach.name }}</h3>
                                    <span class="coach-meta" style="font-size: 0.8rem; color: var(--accent-gold);">{{ coach.specialization }}</span>
                                </div>
                            </div>
                            <p class="pro-bio">{{ coach.bio }}</p>
                            <div class="session-row compact">
                                <div>
                                    <span class="price-text">{{ coach.hourlyRate ?? 'TBD' }}</span>
                                </div>
                                {% if app.user and coach.user and app.user.id == coach.user.id %}
                                    <a href="{{ path('app_coach_show', {'id': coach.id}) }}"
                                       class="book-btn"
                                       style="background: rgba(234,219,186,0.15); color: var(--accent-gold); border: 1px solid var(--accent-gold);">YOU</a>
                                {% elseif app.user and app.user.coachProfile and app.user.coachProfile.status == 'approved' %}
                                    <a href="{{ path('app_coach_show', {'id': coach.id}) }}"
                                       class="book-btn"
                                       style="background: transparent; border: 1px solid var(--border-color); color: var(--text-muted);">View</a>
                                {% elseif app.user %}
                                    <a href="{{ path('app_booking_new', {'id': coach.id}) }}" class="book-btn">Book</a>
                                {% else %}
                                    <a href="{{ path('app_login') }}" class="book-btn" style="opacity: 0.7;">Login to Book</a>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </section>

    {# ================================================
       SECTION 2: COACH APPLICATION FORM
       Only shown if user is logged in and hasn't already applied
    ================================================ #}
    {% if app.user and existing_application is null %}
        <section id="coach-apply" style="margin-top: 4rem; padding-top: 3rem; border-top: 1px solid var(--border-color);">
            <h2 class="section-title">APPLY TO BECOME A COACH</h2>
            <p style="color: var(--text-muted); text-align: center; max-width: 600px; margin: 0 auto 2.5rem;">
                Think you have what it takes? Submit an application and our team will review your credentials.
                Approved coaches are listed on this page and receive bookings from students worldwide.
            </p>

            <div style="max-width: 600px; margin: 0 auto; background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 12px; padding: 2.5rem;">
                {{ form_start(application_form, {'attr': {'class': 'coach-apply-form', 'novalidate': 'novalidate', 'data-turbo': 'false'}}) }}

                    <div class="form-group">
                        {{ form_label(application_form.name, 'Display Name', {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(application_form.name) }}
                        {{ form_errors(application_form.name) }}
                    </div>

                    <div class="form-group">
                        {{ form_label(application_form.imageFile, 'Profile Picture', {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(application_form.imageFile) }}
                        {{ form_errors(application_form.imageFile) }}
                        <small class="form-hint">Upload a custom square avatar (JPG, PNG, WEBP). If omitted, a default NightLock badge avatar will be assigned.</small>
                    </div>

                    <div class="form-group">
                        {{ form_label(application_form.specialization, 'Specialization', {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(application_form.specialization) }}
                        {{ form_errors(application_form.specialization) }}
                        <small class="form-hint">e.g. Carry, Support, Offlane, All-rounder</small>
                    </div>

                    <div class="form-group">
                        {{ form_label(application_form.hourlyRate, 'Hourly Rate', {'label_attr': {'class': 'form-label'}}) }}
                        <div style="display: flex; align-items: center; gap: 0.5rem;">
                            <span style="font-weight: 700; color: var(--accent-gold); font-size: 1.1rem;">₱</span>
                            {{ form_widget(application_form.hourlyRate) }}
                        </div>
                        {{ form_errors(application_form.hourlyRate) }}
                        <small class="form-hint">Enter your rate in Philippine Pesos (e.g. 500 automatically becomes ₱500/hr).</small>
                    </div>

                    <div class="form-group">
                        {{ form_label(application_form.bio, 'Bio / Credentials', {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(application_form.bio) }}
                        {{ form_errors(application_form.bio) }}
                        <small class="form-hint">Describe your rank, experience, and coaching style (minimum 5 characters).</small>
                    </div>

                    <button type="submit" class="book-btn" style="width: 100%; margin-top: 1rem; font-size: 1rem; padding: 0.85rem;">
                        SUBMIT APPLICATION
                    </button>

                {{ form_end(application_form) }}
            </div>
        </section>
    {% elseif app.user %}
        <section id="coach-application-status" style="margin-top: 4rem; text-align: center; padding: 2rem; border-top: 1px solid var(--border-color);">
            <h3 style="color: var(--accent-gold);">COACH APPLICATION {{ existing_application.status|upper }}</h3>
            <p style="color: var(--text-muted); margin: 0.75rem 0 1.5rem;">
                {% if existing_application.status == 'pending' %}
                    Your coach application is awaiting review.
                {% elseif existing_application.status == 'approved' %}
                    Your coach profile is approved and visible to students.
                {% else %}
                    Your coach application was not approved. Please contact the team if you need more information.
                {% endif %}
            </p>
        </section>
    {% else %}
        <section style="margin-top: 3rem; text-align: center; padding: 2rem; border-top: 1px solid var(--border-color);">
            <h3 style="color: var(--accent-gold);">WANT TO COACH?</h3>
            <p style="color: var(--text-muted); margin: 0.75rem 0 1.5rem;">
                Create an account and apply to join our coaching roster.
            </p>
            <a href="{{ path('app_register') }}" class="book-btn">CREATE ACCOUNT</a>
        </section>
    {% endif %}

</div>
{% endblock %}
