{% extends 'base.html.twig' %}

{% block title %}{{ coach.name }} - Coach Profile | NightLock{% endblock %}

{% block body %}
{% set is_own_profile = app.user and coach.user and app.user.id == coach.user.id %}
{% set is_coach = app.user and app.user.coachProfile and app.user.coachProfile.status == 'approved' %}

<div style="max-width: 1100px; margin: 0 auto; padding: 3rem 1.5rem;">

    {# ── BREADCRUMB ── #}
    <nav style="margin-bottom: 2rem; color: var(--text-muted); font-size: 0.85rem;">
        <a href="{{ path('app_coaches') }}" style="color: var(--accent-gold); text-decoration: none;">← Back to Coaches</a>
    </nav>

    {# ── HERO / PROFILE HEADER ── #}
    <div class="featured-card" style="margin-bottom: 3rem;">
        {# Col 1: Avatar & identity #}
        <div class="featured-profile">
            {% if coach.image %}
                <img src="{{ asset('images/' ~ coach.image) }}" alt="{{ coach.name }}" class="featured-avatar" onerror="this.onerror=null; this.src='{{ asset('images/default-avatar.png') }}';">
            {% else %}
                <img src="{{ asset('images/default-avatar.png') }}" alt="{{ coach.name }}" class="featured-avatar">
            {% endif %}

            <h2 style="margin: 1rem 0 0.25rem; color: #fff;">{{ coach.name }}</h2>
            <span class="coach-meta">{{ coach.specialization }}</span>

            <div style="margin-top: 0.5rem;">
                <span class="badge-number1"
                      style="{% if coach.tier == 'featured' %}background: linear-gradient(135deg, #EADBBA, #b8986a);{% elseif coach.tier == 'pro' %}background: rgba(234,219,186,0.15);{% else %}background: rgba(255,255,255,0.05);{% endif %}">
                    {{ coach.tier|upper }}
                </span>
            </div>

            <p style="color: var(--accent-gold); font-size: 1.4rem; font-weight: 700; margin-top: 1.25rem;">
                {{ coach.hourlyRate ?? 'TBD' }}{% if coach.hourlyRate and not ('/hr' in coach.hourlyRate) %}<span style="font-size: 0.8rem; color: var(--text-muted);"> / hr</span>{% endif %}
            </p>

            {% if is_own_profile %}
                <a href="{{ path('app_coach_edit', {'id': coach.id}) }}"
                   class="book-btn"
                   style="width: 100%; text-align: center; margin-top: 1rem; font-size: 0.95rem; padding: 0.85rem; background: rgba(234,219,186,0.15); color: var(--accent-gold); border: 1px solid var(--accent-gold);">
                    EDIT YOUR PROFILE
                </a>
            {% elseif is_coach %}
                <div style="margin-top: 1rem; padding: 0.75rem; text-align: center; background: rgba(255,255,255,0.04); border: 1px solid var(--border-color); border-radius: 6px; font-size: 0.825rem; color: var(--text-muted);">
                    Signed in as Coach
                </div>
            {% elseif app.user %}
                <a href="{{ path('app_booking_new', {'id': coach.id}) }}"
                   class="book-btn"
                   style="width: 100%; text-align: center; margin-top: 1rem; font-size: 1rem; padding: 0.85rem;">
                    BOOK A SESSION
                </a>
            {% else %}
                <a href="{{ path('app_login') }}"
                   class="book-btn"
                   style="width: 100%; text-align: center; margin-top: 1rem; opacity: 0.7;">
                    LOG IN TO BOOK
                </a>
            {% endif %}
        </div>

        {# Col 2: Bio #}
        <div class="featured-details">
            <h3 style="color: var(--accent-gold); margin-bottom: 1rem;">ABOUT</h3>
            <p style="color: var(--text-muted); line-height: 1.75; font-size: 0.95rem;">
                {{ coach.bio ?? 'This coach has not provided a bio yet.' }}
            </p>
        </div>

        {# Col 3: Quick Stats #}
        <div class="featured-reviews">
            <h4>QUICK INFO</h4>
            <div style="display: flex; flex-direction: column; gap: 1rem; margin-top: 1rem;">
                <div style="background: var(--bg-dark); border: 1px solid var(--border-color); border-radius: 8px; padding: 1rem;">
                    <span style="color: var(--text-muted); font-size: 0.75rem; display: block; margin-bottom: 0.25rem;">SPECIALIZATION</span>
                    <strong style="color: #fff;">{{ coach.specialization }}</strong>
                </div>
                <div style="background: var(--bg-dark); border: 1px solid var(--border-color); border-radius: 8px; padding: 1rem;">
                    <span style="color: var(--text-muted); font-size: 0.75rem; display: block; margin-bottom: 0.25rem;">HOURLY RATE</span>
                    <strong style="color: var(--accent-gold);">{{ coach.hourlyRate ?? 'TBD' }}</strong>
                </div>
                <div style="background: var(--bg-dark); border: 1px solid var(--border-color); border-radius: 8px; padding: 1rem;">
                    <span style="color: var(--text-muted); font-size: 0.75rem; display: block; margin-bottom: 0.25rem;">RATING</span>
                    <strong style="color: #fff;">
                        {% if coach.averageRating %}
                            <span style="color: var(--accent-gold);">★ {{ coach.averageRating }}</span>
                            <span style="font-size: 0.8rem; color: var(--text-muted); font-weight: normal;">({{ coach.reviews|length }} review{{ coach.reviews|length == 1 ? '' : 's' }})</span>
                        {% else %}
                            <span style="color: var(--text-muted); font-weight: normal; font-size: 0.85rem;">No reviews yet</span>
                        {% endif %}
                    </strong>
                </div>
                <div style="background: var(--bg-dark); border: 1px solid var(--border-color); border-radius: 8px; padding: 1rem;">
                    <span style="color: var(--text-muted); font-size: 0.75rem; display: block; margin-bottom: 0.25rem;">MEMBER SINCE</span>
                    <strong style="color: #fff;">{{ coach.createdAt|date('M Y') }}</strong>
                </div>
            </div>
        </div>
    </div>

    {# ── STUDENT REVIEWS SECTION ── #}
    <div style="margin-top: 3rem; background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 12px; padding: 2.5rem;">
        <h3 style="color: var(--accent-gold); margin-top: 0; margin-bottom: 1.5rem; font-size: 1.2rem; letter-spacing: 0.05em;">
            STUDENT REVIEWS
            {% if coach.reviews is not empty %}
                <span style="font-size: 0.9rem; color: var(--text-muted); font-weight: normal; margin-left: 0.5rem;">
                    (★ {{ coach.averageRating }} avg &bull; {{ coach.reviews|length }} review{{ coach.reviews|length == 1 ? '' : 's' }})
                </span>
            {% endif %}
        </h3>

        {% if coach.reviews is empty %}
            <p style="color: var(--text-muted); margin: 0; font-size: 0.9rem;">
                No reviews yet for this coach. Be the first to book a session and leave a review!
            </p>
        {% else %}
            <div style="display: flex; flex-direction: column; gap: 1.25rem;">
                {% for review in coach.reviews %}
                    <div style="background: var(--bg-dark); border: 1px solid var(--border-color); border-radius: 8px; padding: 1.25rem 1.5rem;">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem; flex-wrap: wrap; gap: 0.5rem;">
                            <div>
                                <span style="color: #fff; font-weight: 600; font-size: 0.95rem;">
                                    {{ review.client.steamName ?? review.client.email }}
                                </span>
                                <span style="color: var(--text-muted); font-size: 0.8rem; margin-left: 0.5rem;">
                                    {{ review.createdAt|date('M d, Y') }}
                                </span>
                            </div>
                            <div style="color: var(--accent-gold); font-size: 0.95rem;">
                                {% for i in 1..5 %}
                                    {% if i <= review.rating %}★{% else %}☆{% endif %}
                                {% endfor %}
                            </div>
                        </div>
                        <p style="margin: 0; color: var(--text-muted); font-size: 0.9rem; line-height: 1.6;">
                            {{ review.comment }}
                        </p>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>

</div>
{% endblock %}
