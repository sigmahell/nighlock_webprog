{% extends 'base.html.twig' %}

{% block title %}Coach Dashboard - NightLock{% endblock %}

{% block body %}
<div style="max-width: 950px; margin: 0 auto; padding: 3rem 1.5rem;">

    <h2 class="section-title">MY OCCULT PROFILE</h2>

    {# ── COACH & USER INFO CARD (Matching User Dashboard) ── #}
    <div class="profile-card" style="display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 12px; padding: 1.75rem 2rem; margin-bottom: 2.5rem; flex-wrap: wrap;">
        <div style="display: flex; align-items: center; gap: 1.5rem;">
            {% if coach.image %}
                <img src="{{ asset('images/' ~ coach.image) }}" alt="{{ coach.name }}"
                     style="width: 68px; height: 68px; border-radius: 50%; object-fit: cover; border: 2px solid var(--accent-gold); flex-shrink: 0;"
                     onerror="this.onerror=null; this.src='{{ asset('images/default-avatar.png') }}';">
            {% else %}
                <div class="profile-avatar-circle" style="width: 68px; height: 68px; border-radius: 50%; background: linear-gradient(135deg, #EADBBA, #8b6914); display: flex; align-items: center; justify-content: center; font-size: 1.7rem; font-weight: 700; color: #151922; flex-shrink: 0;">
                    {{ app.user.steamName ? app.user.steamName|first|upper : (coach.name ? coach.name|first|upper : app.user.email|first|upper) }}
                </div>
            {% endif %}

            <div class="profile-info">
                <h3 style="margin: 0 0 0.3rem; color: #fff; font-size: 1.25rem;">
                    {{ app.user.steamName ?? coach.name }}
                    {% if coach.name != app.user.steamName %}
                        <span style="font-size: 0.85rem; color: var(--accent-gold); font-weight: 400; margin-left: 0.5rem;">({{ coach.name }})</span>
                    {% endif %}
                </h3>
                <p style="margin: 0; color: var(--text-muted); font-size: 0.875rem;">
                    {{ app.user.email }}
                    {% if app.user.steamId %}
                        &nbsp;•&nbsp;Steam ID: <span style="color: var(--accent-gold);">{{ app.user.steamId }}</span>
                    {% endif %}
                </p>
                <div style="display: flex; align-items: center; gap: 0.5rem; margin-top: 0.5rem; flex-wrap: wrap;">
                    <span style="background: rgba(234,219,186,0.15); color: var(--accent-gold); padding: 3px 10px; border-radius: 4px; font-size: 0.75rem; font-weight: 700; text-transform: uppercase;">
                        COACH • {{ coach.specialization }}
                    </span>
                    <span style="background: rgba(255,255,255,0.06); color: var(--text-muted); padding: 3px 10px; border-radius: 4px; font-size: 0.75rem;">
                        Rate: <strong style="color: var(--accent-gold);">{{ coach.hourlyRate }}</strong>
                    </span>
                    <span style="background: rgba(76, 175, 80, 0.15); color: #4caf50; padding: 3px 10px; border-radius: 4px; font-size: 0.75rem; font-weight: 600;">
                        Status: Approved
                    </span>
                </div>
            </div>
        </div>

        <div>
            <a href="{{ path('app_coach_show', {'id': coach.id}) }}" class="book-btn" style="text-decoration: none; padding: 0.65rem 1.25rem; font-size: 0.85rem; display: inline-block;">
                VIEW PUBLIC PROFILE
            </a>
        </div>
    </div>

    {# ── STUDENT REQUESTS SECTION ── #}
    <h3 style="color: var(--accent-gold); margin: 2rem 0 1rem; font-size: 1.15rem; letter-spacing: 0.05em;">
        STUDENT COACHING REQUESTS
    </h3>

    {% if bookings is empty %}
        <div style="background: var(--bg-card); border: 1px dashed var(--border-color); border-radius: 10px; padding: 3rem; text-align: center;">
            <p style="color: var(--text-muted); margin: 0;">You do not have any coaching requests from students yet.</p>
        </div>
    {% else %}
        <div style="display: flex; flex-direction: column; gap: 1rem;">
            {% for booking in bookings %}
                {# Determine badge colors #}
                {% if booking.status == 'accepted' %}
                    {% set badge_color = '#2ecc71' %}
                    {% set badge_bg = 'rgba(46, 204, 113, 0.15)' %}
                {% elseif booking.status == 'pending' %}
                    {% set badge_color = '#f39c12' %}
                    {% set badge_bg = 'rgba(243, 156, 18, 0.15)' %}
                {% elseif booking.status == 'completed' %}
                    {% set badge_color = '#4caf50' %}
                    {% set badge_bg = 'rgba(76, 175, 80, 0.15)' %}
                {% elseif booking.status in ['denied', 'cancelled'] %}
                    {% set badge_color = '#e74c3c' %}
                    {% set badge_bg = 'rgba(231, 76, 60, 0.15)' %}
                {% else %}
                    {% set badge_color = '#95a5a6' %}
                    {% set badge_bg = 'rgba(149, 165, 166, 0.12)' %}
                {% endif %}

                <article style="background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 10px; padding: 1.5rem; display: flex; justify-content: space-between; gap: 1.5rem; align-items: center; flex-wrap: wrap;">
                    <div>
                        <h4 style="margin: 0 0 0.35rem; color: #fff; font-size: 1.05rem;">
                            {{ booking.sessionTitle }}
                        </h4>
                        <p style="margin: 0 0 0.3rem; color: var(--accent-gold); font-size: 0.9rem;">
                            Student: <strong style="color: #fff;">{{ booking.client.steamName ?? booking.client.email }}</strong>
                            {% if booking.client.steamId %}
                                <span style="color: var(--text-muted); font-size: 0.8rem;">(Steam: {{ booking.client.steamId }})</span>
                            {% endif %}
                        </p>
                        <p style="margin: 0; color: var(--text-muted); font-size: 0.85rem;">
                            Scheduled: {{ booking.scheduledAt|date('M d, Y \\a\\t H:i') }}
                            {% if booking.price %}
                                &nbsp;•&nbsp;<span style="color: var(--accent-gold); font-weight: 600;">{{ booking.price }}</span>
                            {% endif %}
                        </p>
                        {% if booking.clientNotes %}
                            <p style="margin: 0.65rem 0 0; color: var(--text-muted); font-size: 0.825rem; max-width: 650px; background: rgba(0,0,0,0.2); padding: 0.5rem 0.75rem; border-radius: 6px; border: 1px solid rgba(255,255,255,0.05);">
                                <strong style="color: var(--accent-gold);">Student Notes / Discord:</strong> {{ booking.clientNotes }}
                            </p>
                        {% endif %}
                    </div>

                    <div style="display: flex; flex-direction: column; align-items: flex-end; gap: 0.65rem; flex-shrink: 0;">
                        <span style="padding: 4px 12px; border-radius: 4px; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; background: {{ badge_bg }}; color: {{ badge_color }};">
                            {{ booking.status }}
                        </span>

                        <div style="display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap;">
                            {% if booking.status == 'pending' %}
                                {% for action, label in {'accept': 'Accept', 'deny': 'Deny'} %}
                                    <form method="post" action="{{ path('app_coach_booking_update', {id: booking.id, action: action}) }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('coach_booking_' ~ booking.id) }}">
                                        <button type="submit" class="book-btn" style="border: none; cursor: pointer; padding: 0.5rem 1rem; font-size: 0.85rem; {% if action == 'deny' %}background: rgba(231,76,60,.15); color: #e74c3c; border: 1px solid rgba(231,76,60,0.3);{% endif %}">{{ label }}</button>
                                    </form>
                                {% endfor %}
                            {% elseif booking.status == 'accepted' %}
                                <form method="post" action="{{ path('app_coach_booking_update', {id: booking.id, action: 'complete'}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('coach_booking_' ~ booking.id) }}">
                                    <button type="submit" class="book-btn" style="border: none; cursor: pointer; padding: 0.5rem 1rem; font-size: 0.85rem; background: #2ecc71; color: #151922;">Mark Completed</button>
                                </form>
                            {% endif %}
                        </div>
                    </div>
                </article>
            {% endfor %}
        </div>
    {% endif %}

</div>
{% endblock %}
