{% extends 'base.html.twig' %}

{% block title %}Notifications - NightLock{% endblock %}

{% block body %}
<div style="max-width: 850px; margin: 0 auto; padding: 3rem 1.5rem;">
    <div style="display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap; margin-bottom: 2rem;">
        <h2 class="section-title" style="margin: 0;">NOTIFICATIONS{% if unread_count %} ({{ unread_count }}){% endif %}</h2>
        {% if unread_count %}
            <form method="post" action="{{ path('app_notifications_read_all') }}">
                <input type="hidden" name="_token" value="{{ csrf_token('notifications_read_all') }}">
                <button type="submit" class="book-btn" style="border: none; cursor: pointer;">MARK ALL READ</button>
            </form>
        {% endif %}
    </div>

    {% if notifications is empty %}
        <div style="background: var(--bg-card); border: 1px dashed var(--border-color); border-radius: 10px; padding: 3rem; text-align: center;">
            <p style="color: var(--text-muted); margin: 0;">No notifications yet. Booking and application updates will appear here.</p>
        </div>
    {% else %}
        <div style="display: grid; gap: .85rem;">
            {% for notification in notifications %}
                <article style="background: var(--bg-card); border: 1px solid {% if notification.read %}var(--border-color){% else %}var(--accent-gold){% endif %}; border-radius: 9px; padding: 1.25rem 1.5rem; display: flex; justify-content: space-between; gap: 1rem; align-items: center; flex-wrap: wrap; {% if not notification.read %}box-shadow: inset 3px 0 0 var(--accent-gold);{% endif %}">
                    <div>
                        <h3 style="margin: 0 0 .4rem; color: #fff; font-size: 1rem;">{{ notification.title }}</h3>
                        <p style="margin: 0; color: var(--text-muted);">{{ notification.message }}</p>
                        <span style="display: inline-block; margin-top: .65rem; font-size: .78rem; color: var(--text-muted);">{{ notification.createdAt|date('M d, Y \\a\\t H:i') }}</span>
                    </div>
                    {% if not notification.read %}
                        <form method="post" action="{{ path('app_notification_read', {id: notification.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('notification_' ~ notification.id) }}">
                            <button type="submit" class="book-btn" style="border: none; cursor: pointer;">MARK READ</button>
                        </form>
                    {% endif %}
                </article>
            {% endfor %}
        </div>
    {% endif %}
</div>
{% endblock %}
