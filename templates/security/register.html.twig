{% extends 'base.html.twig' %}

{% block title %}Register - NightLock{% endblock %}

{% block body %}
<div style="padding: 3rem 1.5rem;">
    <h2 class="section-title auth-title">CREATE AN OCCULT ACCOUNT</h2>

    <div class="auth-card">

        {{ form_start(registrationForm, {
            'attr': {'novalidate': 'novalidate'}
        }) }}

            {# EMAIL #}
            <div class="form-group">
                {{ form_label(registrationForm.email, null, {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(registrationForm.email) }}
                {{ form_errors(registrationForm.email) }}
            </div>

            {# STEAM NAME #}
            <div class="form-group">
                {{ form_label(registrationForm.steamName, null, {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(registrationForm.steamName) }}
                {{ form_errors(registrationForm.steamName) }}
                <small class="form-hint">Your in-game display name shown on your profile.</small>
            </div>

            {# STEAM ID #}
            <div class="form-group">
                {{ form_label(registrationForm.steamId, null, {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(registrationForm.steamId) }}
                {{ form_errors(registrationForm.steamId) }}
                <small class="form-hint">
                    Optional. Find yours at
                    <a href="https://steamid.io" target="_blank" rel="noopener noreferrer"
                       style="color: var(--accent-gold);">steamid.io</a>
                    (must be 17 digits).
                </small>
            </div>

            {# PASSWORD #}
            <div class="form-group">
                {{ form_label(registrationForm.plainPassword.first, null, {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(registrationForm.plainPassword.first) }}
                {{ form_errors(registrationForm.plainPassword.first) }}
                <small class="form-hint">Minimum 8 characters.</small>
            </div>

            {# CONFIRM PASSWORD #}
            <div class="form-group">
                {{ form_label(registrationForm.plainPassword.second, null, {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(registrationForm.plainPassword.second) }}
                {{ form_errors(registrationForm.plainPassword.second) }}
            </div>

            {# Global form errors (e.g. password mismatch) #}
            {{ form_errors(registrationForm) }}

            <button type="submit" class="book-btn full-width"
                    style="border: none; cursor: pointer; padding: 0.85rem; margin-top: 0.5rem;">
                JOIN NIGHTLOCK
            </button>

        {{ form_end(registrationForm) }}

        <div style="margin-top: 1.5rem; text-align: center; font-size: 0.85rem; color: var(--text-muted);">
            Already registered?
            <a href="{{ path('app_login') }}"
               style="color: var(--accent-gold); text-decoration: none; font-weight: 600;">Sign in</a>
        </div>

    </div>
</div>
{% endblock %}
