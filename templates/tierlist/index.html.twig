{% extends 'base.html.twig' %}

{% block title %}Hero Tier List - NightLock{% endblock %}

{% block body %}
<section id="tier-list" style="max-width: 1100px; padding: 3rem 1.5rem;">
    <h2>DEADLOCK HERO TIER LIST</h2>
    <p>Comprehensive competitive meta ranking updated daily from high-MMR occult rituals.</p>

    <div class="tier-container-rows">
        {% for tier_key, tier in tiers %}
            <div class="tier-hero {{ tier.class }}">
                <span class="tier-label">{{ tier.label }}</span>
                <div class="hero-items-container">
                    {% for hero in tier.heroes %}
                        <div class="hero-badge" style="display: flex; flex-direction: column; align-items: center; gap: 0.35rem;">
                            <img src="{{ asset(hero.img) }}" alt="{{ hero.name }}" title="{{ hero.name }}" style="width: 72px; height: 72px; object-fit: cover; border-radius: 6px; border: 1px solid var(--border-color); transition: transform 0.2s ease;" onmouseover="this.style.transform='scale(1.08)'" onmouseout="this.style.transform='scale(1)'">
                            <span style="font-size: 0.75rem; color: var(--text-muted); font-weight: 500;">{{ hero.name }}</span>
                        </div>
                    {% endfor %}
                </div>
            </div>
        {% endfor %}
    </div>

    <div style="margin-top: 3rem;">
        <a href="{{ path('app_home') }}" class="tier-button" style="text-decoration: none; display: inline-block;">← BACK TO HOME</a>
    </div>
</section>
{% endblock %}
