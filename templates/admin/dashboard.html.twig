{% extends 'base.html.twig' %}

{% block title %}Admin Dashboard - NightLock{% endblock %}

{% block body %}
<div style="max-width: 1100px; margin: 0 auto; padding: 3rem 1.5rem;">
    <h2 class="section-title">ADMINISTRATOR OCCULT CONTROL</h2>

    <div class="admin-stats-grid">
        <div class="stat-card">
            <h4>Total Users</h4>
            <div class="stat-number">{{ stats.total_users }}</div>
        </div>
        <div class="stat-card">
            <h4>Active Bookings</h4>
            <div class="stat-number color-pending" style="color: #ffb703;">{{ stats.active_bookings }}</div>
        </div>
        <div class="stat-card">
            <h4>Completed Sessions</h4>
            <div class="stat-number color-approved" style="color: #4caf50;">{{ stats.completed_sessions }}</div>
        </div>
        <div class="stat-card">
            <h4>Registered Coaches</h4>
            <div class="stat-number">{{ stats.registered_coaches }}</div>
        </div>
    </div>

    <h3 style="color: var(--accent-gold); margin: 2rem 0 1rem 0; font-size: 1.2rem;">RECENT INQUIRIES</h3>
    <div class="admin-table-wrapper">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Sender</th>
                    <th>Email</th>
                    <th>Inquiry Details</th>
                    <th>Received</th>
                </tr>
            </thead>
            <tbody>
                {% for inquiry in inquiries %}
                    <tr>
                        <td style="font-weight: 600; color: #fff;">{{ inquiry.name }}</td>
                        <td style="color: var(--accent-gold);">{{ inquiry.email }}</td>
                        <td style="color: var(--text-muted);">{{ inquiry.message }}</td>
                        <td style="color: var(--text-muted); font-size: 0.85rem;">{{ inquiry.date }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
