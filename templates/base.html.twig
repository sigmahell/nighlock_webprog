<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}NightLock - Your Occult Tracker for Deadlock{% endblock %}</title>
        <link rel="icon" type="image/png" href="{{ asset('images/logo.png') }}">

        {% block stylesheets %}
            <link rel="stylesheet" href="{{ asset('css/style.css') }}">
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body>
        {{ include('partials/_nav.html.twig') }}

        {# Global flash message notifications #}
        {% for type, messages in app.flashes %}
            {% for message in messages %}
                <div style="max-width: 900px; margin: 1.5rem auto 0 auto; padding: 1rem 1.5rem; border-radius: 6px; font-weight: 500; text-align: center; {% if type == 'success' %}background: rgba(46, 204, 113, 0.2); border: 1px solid #2ecc71; color: #a3e9b8;{% else %}background: rgba(231, 76, 60, 0.2); border: 1px solid #e74c3c; color: #f5a9a4;{% endif %}">
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}

        <main>
            {% block body %}{% endblock %}
        </main>

        {{ include('partials/_footer.html.twig') }}
    </body>
</html>
